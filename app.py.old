# -*- coding: utf-8 -*-
"""Aplicativo Streamlit: Gap Tesouro Direto × Patrimar.

Acompanha diariamente a diferença entre o valor líquido do Tesouro Direto e o
saldo devedor do financiamento Patrimar. Basta adicionar novos arquivos à pasta
``arquivos/`` e recarregar a página (F5) para recalcular toda a série.
"""

from __future__ import annotations

from pathlib import Path
import pandas as pd
import plotly.graph_objects as go
import streamlit as st

from tesouro_gap.processor import GapProcessor
from tesouro_gap.utils import formatar_moeda

# ============================================================================
# CONSTANTES E CONFIGURAÇÕES
# ============================================================================

# Diretório onde ficam os arquivos XLSX (Tesouro) e CSV (Patrimar).
DIRETORIO_DADOS = Path(__file__).resolve().parent / "arquivos"

# Cores das séries no gráfico (em formato hex)
COR_VALOR_LIQUIDO = "#1f77b4"  # Azul
COR_SALDO_DEVEDOR = "#d62728"  # Vermelho
COR_GAP = "#2ca02c"  # Verde

# Cores específicas para as visualizações adicionais (quando não existirem constantes)
COR_GAUGE_VERMELHO = "#C0392B"
COR_GAUGE_AMARELO = "#D4A017"
COR_GAUGE_VERDE = "#6AAF3D"
COR_GAUGE_ESCURA = "#1A3A1A"

# Data‑limite da projeção da evolução do Saldo devedor e do Valor líquido.
DATA_LIMITE_PROJECAO = pd.Timestamp("2030-07-31")
# Taxa anual padrão (parametrizável) aplicada à projeção do saldo Patrimar.
TAXA_PATRIMAR_PADRAO_PCT = 8.0
# IPCA anual padrão (parametrizável) composto com o spread contratado do
# Tesouro. Os títulos Tesouro IPCA+ são híbridos: rendem o spread contratado
# (ex.: 8,26%) COMPOSTO com a variação do IPCA do período. A projeção do valor
# líquido usa a taxa efetiva = (1 + spread) * (1 + IPCA) - 1.
IPCA_PADRAO_PCT = 0.0
# Valor padrão (parametrizável) do aporte mensal na NTN-B+ 2032.
APORTE_MENSAL_PADRAO = 1000.0
# Datas de aportes extras no Valor líquido durante a projeção.
DATAS_APORTE_EXTRA = (
    pd.Timestamp("2027-07-10"),
    pd.Timestamp("2028-07-10"),
    pd.Timestamp("2029-07-10"),
    pd.Timestamp("2030-07-10"),
)
# Valor padrão (parametrizável) de cada aporte extra (Saque‑Aniversário FGTS).
APORTE_EXTRA_PADRAO = 10000.0

# ============================================================================
# FUNÇÕES UTILITÁRIAS
# ============================================================================

# ---- Formatação de Valores ----

def _formatar_taxa(taxa: float) -> str:
    """Formata uma taxa (fração decimal) como percentual brasileiro."""
    return f"{taxa * 100:.2f}".replace(".", ",") + "% a.a."

def _crescer(valor_inicial: float, taxa_anual: float, dias: int) -> float:
    """Aplica juros compostos a uma taxa anual por ``dias`` corridos.

    Utiliza a fórmula: V = V0 * (1 + taxa) ^ (dias / 365.25)
    Onde 365.25 é a média de dias por ano (considerando bissextos).

    Args:
        valor_inicial: Valor de partida.
        taxa_anual: Taxa anual como fração decimal (ex.: ``0.08``).
        dias: Quantidade de dias corridos decorridos.

    Returns:
        Valor projetado ao final do período.
    """
    return valor_inicial * (1.0 + taxa_anual) ** (dias / 365.25)

# ---- Projeção de Séries ----

def _construir_projecao(
    df: pd.DataFrame,
    taxa_tesouro: float | None,
    taxa_patrimar: float,
    data_limite: pd.Timestamp,
    aporte_mensal: float = 0.0,
    aporte_extra: float = 0.0,
    datas_aporte_extra: tuple[pd.Timestamp, ...] = (),
) -> pd.DataFrame:
    """Projeta o Valor líquido e o Saldo devedor até ``data_limite``.

    Cada série cresce por juros compostos a partir de sua última observação
    real: o Valor líquido usa a taxa média contratada do Tesouro; o Saldo
    devedor usa a taxa do INCC. Os pontos são mensais e o último ponto é
    exatamente ``data_limite``.

    Args:
        df: Série histórica real consolidada.
        taxa_tesouro: Taxa anual do Tesouro (fração decimal) ou ``None``.
        taxa_patrimar: Taxa anual da Patrimar (fração decimal).
        data_limite: Data final da projeção.
        aporte_mensal: Valor aportado a cada mês no Valor líquido. Cada aporte
            é somado no respectivo ponto mensal e passa a render à taxa do
            Tesouro nos meses seguintes.
        aporte_extra: Valor de cada aporte extra pontual no Valor líquido.
        datas_aporte_extra: Datas em que o ``aporte_extra`` é aplicado. Cada
            aporte extra passa a render à taxa do Tesouro a partir da sua data.

    Returns:
        DataFrame com ``data``, ``valor_liquido``, ``saldo_devedor`` e ``gap``
        para as datas projetadas (sem repetir os pontos reais).
    """
    colunas = ["data", "valor_liquido", "saldo_devedor", "gap"]
    # Extrai as séries de valor líquido e saldo devedor da série histórica
    serie_vl = df.dropna(subset=["valor_liquido"])
    serie_sd = df.dropna(subset=["saldo_devedor"])

    # Retorna erro se alguma série estiver vazia
    if serie_vl.empty or serie_sd.empty:
        return pd.DataFrame(columns=colunas)

    # Identifica os pontos de âncora (últimos dados reais) de cada série
    ancora_vl_data = serie_vl["data"].iloc[-1]
    ancora_vl = float(serie_vl["valor_liquido"].iloc[-1])
    ancora_sd_data = serie_sd["data"].iloc[-1]
    ancora_sd = float(serie_sd["saldo_devedor"].iloc[-1])

    ultima_data = df["data"].max()
    # Se a série histórica já ultrapassa a data‑limite, não há projeção
    if ultima_data >= data_limite:
        return pd.DataFrame(columns=colunas)

    # Cria uma lista de datas mensais a partir do último ponto real até data_limite
    datas: list[pd.Timestamp] = []
    cursor = ultima_data
    while True:
        cursor = cursor + pd.DateOffset(months=1)
        if cursor >= data_limite:
            break
        datas.append(cursor)
    datas.append(data_limite)

    registros = []
    aporte_acumulado = 0.0  # Acumula os aportes mensais e extras
    data_anterior = ultima_data
    # Para cada ponto mensal, calcula valor líquido e saldo devedor projetados
    for data_ponto in datas:
        if taxa_tesouro is None:
            # Se não há taxa do Tesouro, valor líquido é indisponível
            valor_liquido = float("nan")
        else:
            # Projeta o valor base (sem aportes) usando a taxa do Tesouro
            base_vl = _crescer(
                ancora_vl, taxa_tesouro, (data_ponto - ancora_vl_data).days
            )
            # Atualiza e soma aportes mensais
            aporte_acumulado = _crescer(
                aporte_acumulado,
                taxa_tesouro,
                (data_ponto - data_anterior).days,
            ) + aporte_mensal
            # Adiciona aportes extras nas datas especificadas
            for data_extra in datas_aporte_extra:
                if data_anterior < data_extra <= data_ponto:
                    aporte_acumulado += _crescer(
                        aporte_extra,
                        taxa_tesouro,
                        (data_ponto - data_extra).days,
                    )
            valor_liquido = base_vl + aporte_acumulado
        # Projeta o saldo devedor usando a taxa do INCC
        saldo_devedor = _crescer(
            ancora_sd, taxa_patrimar, (data_ponto - ancora_sd_data).days
        )
        # Calcula o gap (valor que ainda falta acumular: saldo - valor líquido)
        registros.append(
            {
                "data": data_ponto,
                "valor_liquido": valor_liquido,
                "saldo_devedor": saldo_devedor,
                "gap": saldo_devedor - valor_liquido,
            }
        )
        data_anterior = data_ponto
    return pd.DataFrame(registros, columns=colunas)

# ---- Construção de Gráficos ----

def _construir_grafico(df: pd.DataFrame, projecao: pd.DataFrame) -> go.Figure:
    """Monta o gráfico Plotly com as séries reais e a projeção.

    Exibe três séries: Valor líquido, Saldo devedor e Gap (a acumular).
    As séries reais são exibidas como linhas contínuas com marcadores.
    As projeções são exibidas como linhas tracejadas, conectadas ao último
    ponto real. Uma linha de meta (gap = 0) marca o objetivo final.

    Args:
        df: Série histórica consolidada (valores reais).
        projecao: Série projetada até a data‑limite.

    Returns:
        Figura Plotly pronta para exibição.
    """
    fig = go.Figure()
    # Define as séries a serem exibidas: (coluna, rótulo, cor)
    series = (
        ("valor_liquido", "Valor líquido", COR_VALOR_LIQUIDO),
        ("saldo_devedor", "Saldo devedor", COR_SALDO_DEVEDOR),
        ("gap", "Gap (a acumular)", COR_GAP),
    )
    # Adiciona as linhas das séries históricas (reais)
    for coluna, rotulo, cor in series:
        # O gap já é positivo (saldo - valor líquido), exibido diretamente
        y = df[coluna]
        fig.add_trace(
            go.Scatter(
                x=df["data"],
                y=y,
                name=rotulo,
                mode="lines+markers",
                line={"color": cor, "width": 2},
                marker={"size": 7},
                hovertemplate=f"{rotulo}: R$ %{{y:,.2f}}<extra></extra>",
            )
        )

    if not projecao.empty:
        # Adiciona as linhas de projeção (tracejadas) se houver dados projetados
        for coluna, rotulo, cor in series:
            _adicionar_linha_projecao(fig, df, projecao, coluna, rotulo, cor)

    # ---- Linha de Meta Zero (Melhoria 3) ----
    # Linha horizontal indicando o objetivo: gap = 0 em 31/07/2030.
    fig.add_hline(
        y=0,
        line_dash="dot",
        line_color="orange",
        line_width=1.5,
        annotation_text="Meta: Gap = 0 (jul/2030)",
        annotation_position="bottom right",
        annotation_font_color="orange",
        annotation_font_size=11,
    )

    # Configura o layout e estilo do gráfico
    fig.update_layout(
        title=(
            "Gap: aplicação no Tesouro IPCA+ 2032 × Saldo Devedor Patrimar "
            "(calculado pelo INCC)"
        ),
        hovermode="x unified",
        legend={"orientation": "h", "yanchor": "bottom", "y": 1.02, "x": 0},
        margin={"l": 20, "r": 20, "t": 60, "b": 20},
        xaxis_title="Data",
        yaxis_title="Valor (R$)",
        template="plotly_white",
    )
    # Adiciona grades no fundo para melhor legibilidade
    fig.update_xaxes(showgrid=True, gridcolor="rgba(0,0,0,0.06)")
    fig.update_yaxes(showgrid=True, gridcolor="rgba(0,0,0,0.06)")
    # Garante que o eixo Y inclua y=0 mesmo com todos os gaps positivos
    fig.update_yaxes(rangemode="tozero")
    return fig

def _adicionar_linha_projecao(
    fig: go.Figure,
    df: pd.DataFrame,
    projecao: pd.DataFrame,
    coluna: str,
    rotulo: str,
    cor: str,
) -> None:
    """Adiciona uma linha tracejada de projeção conectada ao último ponto real.

    A linha de projeção começa no último ponto real (para continuidade visual)
    e segue até a última data projetada. É exibida como tracejada para
    diferenciação dos dados reais.

    Args:
        fig: Figura Plotly em construção.
        df: Série histórica real.
        projecao: Série projetada.
        coluna: Nome da coluna de valores.
        rotulo: Rótulo base da série real.
        cor: Cor da série (a mesma da série real).
    """
    # Filtra dados válidos (sem NaN) da série e projeção
    serie_real = df.dropna(subset=[coluna])
    projecao_valida = projecao.dropna(subset=[coluna])
    if serie_real.empty or projecao_valida.empty:
        return

    # Monta os dados conectando o último ponto real à projeção
    x = [serie_real["data"].iloc[-1], *projecao_valida["data"]]
    y = [float(serie_real[coluna].iloc[-1]), *projecao_valida[coluna]]
    fig.add_trace(
        go.Scatter(
            x=x,
            y=y,
            name=f"{rotulo} (projeção)",
            mode="lines",
            line={"color": cor, "width": 2, "dash": "dash"},
            hovertemplate=f"{rotulo} (projeção): R$ %{{y:,.2f}}<extra></extra>",
        )
    )

# ---- Formatação de Tabelas ----

def _formatar_tabela(df: pd.DataFrame) -> pd.DataFrame:
    """Prepara o DataFrame para exibição amigável na tabela histórica.

    Formata datas no padrão brasileiro (DD/MM/AAAA) e valores monetários
    usando a função ``formatar_moeda`` ou "—" para valores ausentes.

    Args:
        df: Série consolidada contendo a coluna ``tipo`` (Real/Projeção).

    Returns:
        DataFrame formatado com datas e valores em padrão brasileiro.
    """
    # Cria uma tabela formatada com colunas redispostas
    tabela = pd.DataFrame(
        {
            "Data": df["data"].dt.strftime("%d/%m/%Y"),
            "Tipo": df["tipo"],
            "Valor líquido": df["valor_liquido"].map(_moeda_ou_traco),
            "Saldo devedor": df["saldo_devedor"].map(_moeda_ou_traco),
            "Falta acumular": df["gap"].map(_moeda_ou_traco),
        }
    )
    return tabela

def _moeda_ou_traco(valor: float) -> str:
    """Formata como moeda ou devolve "—" quando o valor for ausente (NaN)."""
    if pd.isna(valor):
        return "—"
    return formatar_moeda(float(valor))

# ---- Novas visualizações (funções auxiliares) ----

def _construir_gauge(
    df: pd.DataFrame,
    projecao: pd.DataFrame,
    data_inicio: pd.Timestamp,
    data_limite: pd.Timestamp,
) -> go.Figure:
    """Constrói o gauge de progresso do plano de quitação.

    O gauge mostra o percentual do gap já fechado em relação ao gap inicial,
    indica a variação do gap em reais (delta) em relação ao mês anterior e
    inclui uma linha de referência que representa o progresso esperado
    com base no tempo decorrido.

    Args:
        df: Série histórica real.
        projecao: Série projetada (não utilizada aqui, mas mantida para
            compatibilidade com a assinatura solicitada).
        data_inicio: Data do primeiro ponto da série real.
        data_limite: Data‑limite da projeção (31/07/2030).

    Returns:
        go.Figure contendo o gauge configurado.
    """
    # Segurança contra séries vazias
    if df.empty:
        gap_inicial = 0.0
        gap_atual = 0.0
    else:
        gap_inicial = float(df["gap"].iloc[0])
        gap_atual = float(df["gap"].iloc[-1])

    # Percentual já fechado – evita divisão por zero
    pct_fechado = (
        ((gap_inicial - gap_atual) / gap_inicial) * 100 if gap_inicial != 0 else 0.0
    )

    # Valor de referência para o delta (gap do mês anterior)
    if len(df) >= 2:
        gap_penultimo = float(df["gap"].iloc[-2])
    else:
        gap_penultimo = gap_atual

    # Zonas de cor do gauge
    steps = [
        {"range": [0, 30], "color": COR_GAUGE_VERMELHO},
        {"range": [30, 70], "color": COR_GAUGE_AMARELO},
        {"range": [70, 100], "color": COR_GAUGE_VERDE},
    ]

    # Linha de referência baseada no tempo decorrido
    hoje = pd.Timestamp.now().normalize()
    dias_decorridos = (hoje - data_inicio).days
    dias_totais = (data_limite - data_inicio).days
    progresso_tempo = (
        (dias_decorridos / dias_totais) * 100 if dias_totais != 0 else 0.0
    )

    fig = go.Figure(
        go.Indicator(
            mode="gauge+number+delta",
            value=pct_fechado,
            number={"suffix": "%"},
            delta={
                "reference": gap_penultimo,
                "valueformat": ",.0f",
                "suffix": " R$",
                "increasing": {"color": "red"},
                "decreasing": {"color": "green"},
            },
            gauge={
                "axis": {"range": [0, 100]},
                "steps": steps,
                "threshold": {
                    "line": {"color": "gray", "width": 4},
                    "thickness": 0.75,
                    "value": progresso_tempo,
                },
            },
        )
    )
    fig.update_layout(
        height=350,
        margin={"l": 20, "r": 20, "t": 40, "b": 20},
        template="plotly_white",
    )
    return fig

def _construir_area_empilhada(df: pd.DataFrame, projecao: pd.DataFrame) -> go.Figure:
    """Constrói o gráfico de área empilhada que mostra a composição do saldo devedor.

    As áreas representam o Valor líquido já acumulado (verde) e o Gap ainda a
    acumular (vermelho). Uma linha pontilhada exibe o saldo devedor total. Uma
    linha vertical marca a data do último ponto real.
    """
    # Combina séries reais e projeção
    if projecao.empty:
        combinado = df.copy()
    else:
        combinado = pd.concat([df, projecao], ignore_index=True)
    combinado = combinado.sort_values("data")

    fig = go.Figure()

    # Área Valor líquido (verde)
    fig.add_trace(
        go.Scatter(
            x=combinado["data"],
            y=combinado["valor_liquido"],
            name="NTN-B (já acumulado)",
            mode="none",
            fill="tozeroy",
            fillcolor="rgba(106,175,61,0.7)",
            stackgroup="one",
        )
    )

    # Área Gap (vermelho)
    fig.add_trace(
        go.Scatter(
            x=combinado["data"],
            y=combinado["gap"],
            name="Gap (falta acumular)",
            mode="none",
            fill="tonexty",
            fillcolor="rgba(192,57,43,0.5)",
            stackgroup="one",
        )
    )

    # Linha Saldo devedor total (tracejada)
    fig.add_trace(
        go.Scatter(
            x=combinado["data"],
            y=combinado["saldo_devedor"],
            name="Saldo devedor",
            mode="lines",
            line={"dash": "dot", "color": COR_GAUGE_ESCURA},
        )
    )

    # Linha vertical na data mais recente real
    ultima_data_real = df["data"].iloc[-1]
    # Utiliza add_vline sem anotação para evitar erro de soma de strings.
    fig.add_vline(
        x=ultima_data_real,
        line_dash="dash",
        line_color="gray",
    )
    # Anotação manual indicando "Hoje" na parte superior da linha.
    fig.add_annotation(
        x=ultima_data_real,
        y=1,
        yref="paper",
        text="Hoje",
        showarrow=False,
        xanchor="left",
        yanchor="bottom",
    )

    # Anotação com o valor atual do gap
    gap_atual = float(df["gap"].iloc[-1])
    fig.add_annotation(
        x=ultima_data_real,
        y=gap_atual / 2,
        text=f"Gap atual<br>{formatar_moeda(gap_atual)}",
        showarrow=True,
    )

    fig.update_layout(
        height=400,
        xaxis_title="Data",
        yaxis_title="Valor (R$)",
        legend={"orientation": "h", "y": -0.15, "x": 0},
        template="plotly_white",
    )
    fig.update_yaxes(tickprefix="R$ ", tickformat=",.0f")
    return fig

def _construir_waterfall(df: pd.DataFrame) -> go.Figure | None:
    """Constrói o waterfall que mostra a contribuição mensal para o fechamento do gap.

    Se a série histórica possuir menos de dois pontos, a função retorna ``None``
    e a chamada deve tratar esse caso exibindo uma mensagem informativa.
    """
    df_real = df.dropna(subset=["gap"]).reset_index(drop=True)
    if len(df_real) < 2:
        return None

    variacoes_gap: list[float] = []
    labels: list[str] = []
    for i in range(1, len(df_real)):
        gap_anterior = float(df_real["gap"].iloc[i - 1])
        gap_atual = float(df_real["gap"].iloc[i])
        variacao = gap_anterior - gap_atual  # positivo = redução do gap
        variacoes_gap.append(variacao)
        labels.append(df_real["data"].iloc[i].strftime("%m/%Y"))

    # Barra total representa o gap atual
    gap_atual = float(df_real["gap"].iloc[-1])
    labels.append("Atual")
    y = variacoes_gap + [gap_atual]
    measure = ["relative"] * len(variacoes_gap) + ["total"]

    fig = go.Figure(
        go.Waterfall(
            orientation="v",
            measure=measure,
            x=labels,
            y=y,
            text=[formatar_moeda(v) for v in y],
            textposition="outside",
            connector={"line": {"color": "#888888", "width": 1}},
            increasing={"marker": {"color": "#6AAF3D"}},
            decreasing={"marker": {"color": "#C0392B"}},
            totals={"marker": {"color": "#1A3A1A"}},
        )
    )
    fig.update_layout(height=400, template="plotly_white", showlegend=False)
    # Linha horizontal em y=0 (meta)
    fig.add_hline(
        y=0,
        line_dash="dot",
        line_color="orange",
        annotation_text="Meta: Gap = 0",
        annotation_position="bottom right",
    )
    return fig

def _exibir_resumo_waterfall(df: pd.DataFrame) -> None:
    """Exibe a tabela resumo da contribuição mensal ao gap."""
    df_real = df.dropna(subset=["gap"]).reset_index(drop=True)
    if len(df_real) < 2:
        return

    rows = []
    for i in range(1, len(df_real)):
        mes = df_real["data"].iloc[i].strftime("%m/%Y")
        ntnb_cresceu = df_real["valor_liquido"].iloc[i] - df_real["valor_liquido"].iloc[i - 1]
        incc_cresceu = df_real["saldo_devedor"].iloc[i] - df_real["saldo_devedor"].iloc[i - 1]
        gap_variou = df_real["gap"].iloc[i - 1] - df_real["gap"].iloc[i]
        saldo_gap = df_real["gap"].iloc[i]
        rows.append(
            {
                "Mês": mes,
                "NTN-B cresceu": ntnb_cresceu,
                "INCC cresceu": incc_cresceu,
                "Gap variou": gap_variou,
                "Saldo gap": saldo_gap,
            }
        )
    resumo = pd.DataFrame(rows)

    # Formatação de moedas
    fmt = {
        "NTN-B cresceu": lambda x: formatar_moeda(x),
        "INCC cresceu": lambda x: formatar_moeda(x),
        "Gap variou": lambda x: formatar_moeda(x),
        "Saldo gap": lambda x: formatar_moeda(x),
    }

    # Coloração condicional (verde quando o gap diminuiu, vermelho quando aumentou)
    def _color_gap(val):
        if pd.isna(val):
            return ""
        if val > 0:
            return "background-color:#E8F5E9"
        elif val < 0:
            return "background-color:#FDECEA"
        else:
            return ""

    styled = resumo.style.format(fmt).applymap(_color_gap, subset=["Gap variou"])
    st.write(styled)

def _construir_tabela_delta(df: pd.DataFrame, projecao: pd.DataFrame) -> None:
    """Renderiza a tabela de evolução mensal do gap com Δ e Δ%.

    A tabela combina os pontos reais e projetados, calcula a variação do gap
    em reais e em percentual em relação ao mês anterior e apresenta totais ao
    final. As colunas de variação são coloridas (verde = redução, vermelho = aumento).
    """
    # Prepara df real + projeção com a coluna “tipo”
    df_real = df.copy()
    df_real["tipo"] = "Real"
    if projecao.empty:
        combinado = df_real
    else:
        proj = projecao.copy()
        proj["tipo"] = "Projeção"
        combinado = pd.concat([df_real, proj], ignore_index=True)
    combinado = combinado.sort_values("data").reset_index(drop=True)

    # Cálculo das variações
    combinado["Δ Gap no mês"] = combinado["gap"].shift(1) - combinado["gap"]
    combinado["Δ %"] = (combinado["Δ Gap no mês"] / combinado["gap"].shift(1)) * 100

    # DataFrame para exibição
    tabela = pd.DataFrame(
        {
            "Data": combinado["data"].dt.strftime("%d/%m/%Y"),
            "NTN‑B líquida": combinado["valor_liquido"],
            "Saldo devedor": combinado["saldo_devedor"],
            "Gap": combinado["gap"],
            "Δ Gap no mês": combinado["Δ Gap no mês"],
            "Δ %": combinado["Δ %"],
            "Tipo": combinado["tipo"],
        }
    )

    # Linha de totais
    total_gap = combinado["Δ Gap no mês"].sum(skipna=True)
    total_pct = (
        (total_gap / combinado["gap"].iloc[0]) * 100
        if not combinado.empty and combinado["gap"].iloc[0] != 0
        else 0
    )
    total_row = {
        "Data": "TOTAL",
        "NTN‑B líquida": pd.NA,
        "Saldo devedor": pd.NA,
        "Gap": pd.NA,
        "Δ Gap no mês": total_gap,
        "Δ %": total_pct,
        "Tipo": pd.NA,
    }
    tabela = pd.concat([tabela, pd.DataFrame([total_row])], ignore_index=True)

    # Formatação e coloração
    formatter = {
        "NTN‑B líquida": lambda x: formatar_moeda(x) if pd.notna(x) else "—",
        "Saldo devedor": lambda x: formatar_moeda(x) if pd.notna(x) else "—",
        "Gap": lambda x: formatar_moeda(x) if pd.notna(x) else "—",
        "Δ Gap no mês": lambda x: formatar_moeda(x) if pd.notna(x) else "—",
        "Δ %": lambda x: f"{x:.2f}%".replace(".", ",") if pd.notna(x) else "—",
    }

    def _color_delta(val):
        if pd.isna(val):
            return ""
        if val > 0:
            return "background-color:#E8F5E9"
        elif val < 0:
            return "background-color:#FDECEA"
        else:
            return ""

    styled = tabela.style.format(formatter).applymap(_color_delta, subset=["Δ Gap no mês"])
    st.write(styled)
    st.caption("Verde = gap encolheu (bom) · Vermelho = gap cresceu (atenção)")

# ============================================================================

# FUNÇÃO PRINCIPAL (STREAMLIT)

def main() -> None:
    """Ponto de entrada do aplicativo Streamlit.

    Orquestra o fluxo da aplicação:
    1. Carrega e processa os dados de Tesouro e Patrimar
    2. Calcula a taxa média do Tesouro
    3. Projeta as séries até a data‑limite
    4. Exibe métricas atuais e gráficos
    5. Mostra tabela de histórico e projeção
    """
    st.set_page_config(
        page_title="Gap Tesouro Direto × Patrimar",
        page_icon="📊",
        layout="wide",
    )

    # Título e descrição da aplicação
    st.title("Gap Tesouro Direto × Patrimar")
    st.caption("Evolução diária do patrimônio líquido versus saldo devedor.")

    # ---- Sidebar: Inputs dos Parâmetros de Projeção ----

    with st.sidebar:
        st.header("Parâmetros da projeção")
        # Input: Taxa do INCC para projeção do saldo devedor
        taxa_patrimar_pct = st.number_input(
            "INCC (% a.a.)",
            min_value=0.0,
            max_value=50.0,
            value=TAXA_PATRIMAR_PADRAO_PCT,
            step=0.25,
            help=(
                "Taxa anual usada para projetar a evolução do saldo devedor da "
                "Patrimar até 31/07/2030."
            ),
        )
        # Input: IPCA anual somado ao spread contratado do Tesouro IPCA+
        ipca_pct = st.slider(
            "IPCA (% a.a.)",
            min_value=0.0,
            max_value=50.0,
            value=IPCA_PADRAO_PCT,
            step=0.1,
            help=(
                "Variação anual estimada do IPCA. Como o Tesouro IPCA+ é um "
                "título híbrido, a projeção do valor líquido rende o spread "
                "contratado (ex.: 7,61%) composto com o IPCA. Ex.: IPCA+ 8% "
                "com IPCA de 4% projeta ~12,32% a.a. Altere para recalcular a "
                "projeção."
            ),
        )
        # Input: Aporte mensal na NTN‑B+ 2032
        aporte_mensal = st.number_input(
            "Aporte mensal na NTN‑B+ 2032 (R$)",
            min_value=0.0,
            max_value=1_000_000.0,
            value=1000.0,
            step=100.0,
            help=(
                "Valor aportado todo mês na NTN‑B+ 2032 a partir da projeção. "
                "Cada aporte passa a render à taxa média do Tesouro."
            ),
        )
        # Input: Aporte extra pontual em datas específicas
        aporte_extra = st.number_input(
            "Saque‑Aniversário do FGTS (R$)",
            min_value=0.0,
            max_value=10_000_000.0,
            value=APORTE_EXTRA_PADRAO,
            step=1_000.0,
            help=(
                "Valor do Saque‑Aniversário do FGTS creditado no Valor líquido "
                "em 10/07 de 2027, 2028, 2029 e 2030. Cada saque passa a render "
                "à taxa média do Tesouro."
            ),
        )
    # Converte taxa percentual para fração decimal
    taxa_patrimar = taxa_patrimar_pct / 100.0
    # Converte o IPCA percentual para fração decimal
    ipca = ipca_pct / 100.0

    # ---- Carregamento de Dados ----

    # Processa os arquivos de Tesouro e Patrimar
    try:
        processador = GapProcessor(DIRETORIO_DADOS)
        df = processador.construir_serie()
    except Exception as exc:  # noqa: BLE001 - superfície de erro para o usuário
        st.error(f"Falha ao processar os arquivos: {exc}")
        return

    # Valida se há dados disponíveis
    if df.empty:
        st.warning(
            "Nenhum arquivo encontrado. Adicione os arquivos "
            "`ExtratoAnalitico_*.xlsx` e `resumo_financeiro-*.csv` na pasta "
            "`arquivos/` "
            "e pressione F5."
        )
        return

    # Tenta calcular a taxa média do Tesouro (opcional)
    try:
        taxa_tesouro = processador.obter_taxa_tesouro()
    except Exception as exc:  # noqa: BLE001 - projeção do Tesouro é opcional
        taxa_tesouro = None
        st.warning(f"Não foi possível calcular a taxa média do Tesouro: {exc}")

    # Taxa efetiva do Tesouro IPCA+ = composição do spread contratado com o
    # IPCA. O título é híbrido, então o valor líquido projetado rende o spread
    # composto com a variação do IPCA do período: (1+spread)*(1+IPCA)-1
    # (ex.: spread 7,61% com IPCA 4% ≈ 11,91% a.a.).
    taxa_tesouro_efetiva = (
        (1.0 + taxa_tesouro) * (1.0 + ipca) - 1.0
        if taxa_tesouro is not None
        else None
    )

    # ---- Construção da Projeção ----
    # Calcula os valores projetados até a data‑limite
    projecao = _construir_projecao(
        df, taxa_tesouro_efetiva, taxa_patrimar, DATA_LIMITE_PROJECAO,
        aporte_mensal, aporte_extra, DATAS_APORTE_EXTRA
    )

    # ---- Exibição de Métricas Atuais ----
    # Extrai os dados do último ponto histórico
    ultimo = df.iloc[-1]
    # Extrai os valores para exibição
    valor_liquido = ultimo["valor_liquido"]
    saldo_devedor = ultimo["saldo_devedor"]
    gap = ultimo["gap"]

    # Cria quatro colunas para exibir as métricas principais
    col1, col2, col3, col4 = st.columns(4)
    col1.metric("Valor líquido atual", _moeda_ou_traco(valor_liquido))
    col2.metric("Saldo devedor atual", _moeda_ou_traco(saldo_devedor))
    # Exibe o quanto ainda falta acumular (gap positivo). A cor indica a
    # tendência: verde quando o gap DIMINUI (bom) e vermelho se aumentar.
    if pd.isna(gap):
        col3.markdown("**Falta acumular**")
        col3.markdown("—")
    else:
        # Compara o gap atual com o gap válido imediatamente anterior
        gaps_validos = df["gap"].dropna()
        gap_anterior = (
            float(gaps_validos.iloc[-2]) if len(gaps_validos) >= 2 else float(gap)
        )
        # Verde quando o gap encolheu (ou manteve); vermelho se cresceu
        cor = COR_GAP if float(gap) <= gap_anterior else COR_SALDO_DEVEDOR
        col3.markdown("**Falta acumular**")
        col3.markdown(
            f"<span style='font-size:1.9rem;font-weight:700;color:{cor}'>"
            f"{formatar_moeda(float(gap))}</span>",
            unsafe_allow_html=True,
        )

    # ---- KPI: Redução acumulada do Gap (Melhoria 2) ----
    # Mede quanto o gap já encolheu desde o primeiro ponto da série histórica.
    gaps_serie = df.dropna(subset=["gap"])
    if gaps_serie.empty:
        col4.markdown("**Gap reduzido desde o início**")
        col4.markdown("—")
    else:
        primeiro_gap = float(gaps_serie["gap"].iloc[0])  # gap no início da série
        ultimo_gap = float(gaps_serie["gap"].iloc[-1])  # gap mais recente
        reducao_gap = primeiro_gap - ultimo_gap  # quanto o gap já encolheu
        # A redução é sempre exibida em verde (encolher o gap é sempre positivo)
        col4.markdown("**Gap reduzido desde o início**")
        col4.markdown(
            f"<span style='font-size:1.9rem;font-weight:700;color:{COR_GAP}'>"
            f"{formatar_moeda(reducao_gap)}</span>",
            unsafe_allow_html=True,
        )
        # Porcentagem de redução em relação ao gap inicial
        if primeiro_gap != 0:
            pct_reducao = (reducao_gap / primeiro_gap) * 100
            pct_txt = f"{pct_reducao:.1f}".replace(".", ",")
            col4.markdown(
                f"<span style='color:{COR_GAP};font-weight:600'>"
                f"▼ {pct_txt}% do gap inicial</span>",
                unsafe_allow_html=True,
            )
        # Sublegenda com a data do primeiro ponto da série
        data_inicio = gaps_serie["data"].iloc[0]
        col4.caption(f"Desde {data_inicio.strftime('%d/%m/%Y')}")

    # ---- Legenda com Parâmetros ----
    # Formata a taxa do Tesouro ou retorna "—" se não disponível
    taxa_tesouro_txt = (
        _formatar_taxa(taxa_tesouro) if taxa_tesouro is not None else "—"
    )
    # Formata a taxa efetiva (spread + IPCA) usada na projeção
    taxa_efetiva_txt = (
        _formatar_taxa(taxa_tesouro_efetiva)
        if taxa_tesouro_efetiva is not None
        else "—"
    )
    # Monta a legenda explicando os parâmetros da projeção
    st.caption(
        f"Projeção até **{DATA_LIMITE_PROJECAO.strftime('%d/%m/%Y')}** — "
        f"Valor líquido a **{taxa_efetiva_txt}** (spread contratado de "
        f"**{taxa_tesouro_txt}**, ponderado pelo valor investido, composto com "
        f"IPCA de **{_formatar_taxa(ipca)}**) · Saldo devedor a "
        f"**{_formatar_taxa(taxa_patrimar)}** (INCC, parametrizável) · "
        f"Aporte mensal de **{formatar_moeda(float(aporte_mensal))}** na NTN‑B+ 2032 · Saque‑Aniversário do FGTS de **{formatar_moeda(float(aporte_extra))}** "
        f"em 10/07 de 2027, 2028, 2029 e 2030."
    )

    # ---- Gráfico Principal ----
    # Exibe o gráfico interativo com as séries reais e projeções
    st.plotly_chart(_construir_grafico(df, projecao), width="stretch")

    # ---- Novas visualizações (abas) ----
    tab1, tab2, tab3, tab4 = st.tabs([
        "🎯 Estou no caminho?",
        "📈 Como evoluiu?",
        "🌊 O que moveu o gap?",
        "📋 Evolução mensal",
    ])

    # Aba 1 – Gauge
    with tab1:
        st.subheader("Progresso do Plano de Quitação")
        st.caption("Estou no caminho certo?")
        gauge_fig = _construir_gauge(df, projecao, data_inicio=data_inicio, data_limite=DATA_LIMITE_PROJECAO)
        st.plotly_chart(gauge_fig, use_container_width=True)
        # Métricas abaixo do gauge
        gap_inicial = float(df["gap"].iloc[0]) if not df.empty else 0.0
        gap_atual = float(df["gap"].iloc[-1]) if not df.empty else 0.0
        col_g1, col_g2, col_g3 = st.columns(3)
        col_g1.metric("Gap inicial", formatar_moeda(gap_inicial))
        col_g2.metric("Gap atual", formatar_moeda(gap_atual))
        col_g3.metric("Meta jul/2030", "R$ 0,00")

    # Aba 2 – Área empilhada
    with tab2:
        st.subheader("Composição do Saldo Devedor ao Longo do Tempo")
        st.caption("Como evoluiu ao longo do tempo?")
        area_fig = _construir_area_empilhada(df, projecao)
        st.plotly_chart(area_fig, use_container_width=True)

    # Aba 3 – Waterfall
    with tab3:
        st.subheader("Contribuição Mensal para o Fechamento do Gap")
        st.caption("O que está movendo o gap a cada mês?")
        if len(df) < 2:
            st.info("O waterfall aparece a partir do segundo mês de dados.")
        else:
            wf_fig = _construir_waterfall(df)
            if wf_fig is not None:
                st.plotly_chart(wf_fig, use_container_width=True)
                _exibir_resumo_waterfall(df)

    # Aba 4 – Tabela Δ mensal
    with tab4:
        st.subheader("Evolução Mensal do Gap")
        st.caption("Quanto o gap fechou a cada mês?")
        _construir_tabela_delta(df, projecao)

    # ---- Tabela de Histórico e Projeção ----
    st.subheader("Tabela histórica e projeção")
    # Monta a tabela combinando dados reais com projeções
    df_real = df.copy()
    df_real["tipo"] = "Real"
    # Combina dados reais com projeção
    if projecao.empty:
        combinado = df_real
    else:
        projecao_tabela = projecao.copy()
        projecao_tabela["tipo"] = "Projeção"
        combinado = pd.concat([df_real, projecao_tabela], ignore_index=True)
    # Exibe a tabela formatada
    st.dataframe(
        _formatar_tabela(combinado),
        use_container_width=True,  # Substituiu width="stretch"
        hide_index=True,
    )

# Ponto de entrada da aplicação
if __name__ == "__main__":
    main()
