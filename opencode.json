{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Serpro",
      "options": {
        "baseURL": "{env:SERPRO_CODE_BASE_URL}/v1",
        "apiKey": "{env:SERPRO_CODE_API_KEY}",
        "excludeModels": [
          "serpro-x/*"
        ]
      }
    },
    "litellm-exp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Serpro X",
      "options": {
        "baseURL": "{env:SERPRO_CODE_BASE_URL}/v1",
        "apiKey": "{env:SERPRO_CODE_API_KEY}",
        "includeModels": [
          "serpro-x/*"
        ]
      }
    }
  },
  "disabled_providers": [
    "opencode"
  ],
  "plugin": [
    "@serpro/opencode-plugin-litellm@latest"
  ]
}
